# ==============================================================================
# RentaTool Mobile Environment Configuration Template
# Copy this file to '.env' and adjust the values to match your local setup.
# ==============================================================================

# Protocol scheme (http or https)
API_SCHEME=http

# Backend port (e.g. 5000 for standard local dev)
API_PORT=5000

# API prefix/path
API_PREFIX=api/v1

# Platform-specific hosts:
# - Web & Desktop: localhost
# - Android Emulator: 10.0.2.2
# - Physical Android Device: Your PC's LAN/Wi-Fi IP (e.g., 172.16.4.24) or 127.0.0.1 (if using 'adb reverse tcp:5000 tcp:5000')
# - iOS Simulator: localhost
API_HOST_WEB=localhost
API_HOST_ANDROID=172.16.4.24
API_HOST_IOS=localhost

# Optional: Direct Base URL override.
# If non-empty, this takes precedence over the host/port/scheme settings above.
# Example: API_BASE_URL=http://172.16.4.24:5000/api/v1
API_BASE_URL=

# Request timeout settings (in seconds)
CONNECT_TIMEOUT_SECONDS=15
RECEIVE_TIMEOUT_SECONDS=15
